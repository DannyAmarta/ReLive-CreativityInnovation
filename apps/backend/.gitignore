# 1. Dependencies
node_modules/
dist/
build/

# 2. Environment & Secrets (CRITICAL)
.env
.env.*
!.env.example

# 3. Prisma
# Ignore the generated Prisma Client if you're generating it locally
# but usually, you keep the schema.prisma.
# If you use SQLite for local testing:
*.db
*.db-journal

# 4. User Uploads (VERY IMPORTANT)
# You have an 'uploads' folder. You don't want to commit 
# random test images or user data to GitHub.
uploads/*
!uploads/.gitkeep

# 5. OS & IDE
.DS_Store
.idea/
.vscode/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
testsprite_tests\tmp\config.json
