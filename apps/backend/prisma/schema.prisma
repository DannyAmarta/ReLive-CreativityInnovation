datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User{
  id Int @id @default(autoincrement())
  email String @unique
  password String
  name String?
  bio String?
  avatar String?
  createdAt DateTime @default(now())
  updatedAt DateTime?
  workoutSets WorkoutSet[]
  dailyPerformanceSnapshots DailyPerformanceSnapshot[]
}

model Exercise{
  id String @id
  name String
  category String
  formula String
  description String
  repCap Int?
  requiredMetrics String[]
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workoutSets WorkoutSet[]
  dailyPerformanceSnapshots DailyPerformanceSnapshot[]
}

model WorkoutSet{
  id Int @id @default(autoincrement())
  userId Int
  exerciseId String
  weightLifted Float?
  actualReps Int?
  rirLogged Int?
  calculated1Rm Float?
  formulaUsed String
  isCnsFatigue Boolean @default(false)
  durationMinutes Float?
  distanceMeters Float?
  rpeLogged Float?
  notes String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([userId, exerciseId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model DailyPerformanceSnapshot{
  id Int @id @default(autoincrement())
  userId Int
  exerciseId String
  periodDays Int @default(14)
  snapshotDate DateTime
  emaOneRepMax Float?
  baselineAverage1Rm Float?
  latestLogged1Rm Float?
  latestClean1Rm Float?
  latestRirTrend Float?
  latestSessionFlagged Boolean @default(false)
  contextSummary String
  sampleSize Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([userId, exerciseId, periodDays, snapshotDate])
  @@index([userId, exerciseId, snapshotDate(sort: Desc)])
}

model FoodCache{
  id Int @id @default(autoincrement())
  source String
  sourceId String
  name String
  normalizedName String
  description String?
  brand String?
  referenceServingSize Float?
  referenceServingUnit String?
  caloriesPer100g Float?
  proteinGramsPer100g Float?
  carbsGramsPer100g Float?
  fatGramsPer100g Float?
  fiberGramsPer100g Float?
  sugarGramsPer100g Float?
  sodiumMilligramsPer100g Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, sourceId])
  @@index([normalizedName])
}

model RecipeCache{
  id Int @id @default(autoincrement())
  source String
  sourceId String
  title String
  normalizedTitle String
  image String
  calories Float?
  protein Float?
  cookTime Int?
  ingredients String[]
  instructions String
  sourceUrl String?
  dietTags String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, sourceId])
  @@index([normalizedTitle])
}
