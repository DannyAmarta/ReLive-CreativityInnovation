datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  TRAINER
  ADMIN
}

enum BookingStatus {
  PENDING         // Waiting for trainer acceptance
  ACTIVE          // Trainer accepted, session in progress
  PENDING_RELEASE // Trainer declared done — awaiting client approval or auto-release
  COMPLETED       // Service delivered, funds released to trainer
  DISPUTED        // Claim raised, locked until admin resolves
  CANCELLED       // Mutual cancellation
  REJECTED        // Trainer rejected the booking request
}

enum PaymentType {
  CRYPTO
  FIAT
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model User {
  id            Int     @id @default(autoincrement())
  email         String  @unique
  password      String
  name          String?
  bio           String?
  avatar        String?
  role          Role    @default(USER)
  walletAddress String? @unique
  phone         String? // For fiat payment notifications

  // --- New Onboarding & Lifestyle Fields ---
  profileCompleted Boolean @default(false)
  fitnessLevel     String? // "Sprouting", "Growing", "Evergreen"
  dailyActivity    String? // "Rooted", "Shifting", "Aerial"
  primaryGoal      String? // "Strength", "Weight Loss", "Energy"
  vitalityScore    Int     @default(0) // For your VitalityCard
  streakDays       Int     @default(0) // For your StatBadge

  // --- Security & AI ---
  openRouterApiKeyEncrypted String?
  openRouterKeyLabel        String?
  openRouterUserId          String?
  openRouterConnectedAt     DateTime?

  // --- Metadata ---
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt // Added @updatedAt to auto-track changes

  // --- Relations ---
  workoutSets               WorkoutSet[]
  dailyPerformanceSnapshots DailyPerformanceSnapshot[]
  trainerProfile            TrainerProfile?
  clientBookings            Booking[]                  @relation("ClientBookings")
  fiatWallet                FiatWallet?                // One-to-one with trainer
  withdrawalRequests        WithdrawalRequest[]
  favoriteTrainers          FavoriteTrainer[]
  notifications             Notification[]
  clientReviews             Review[]                   @relation("ClientReviews")
  // Chat relations
  trainerConversations Conversation[] @relation("TrainerConversations")
  clientConversations  Conversation[] @relation("ClientConversations")
  sentMessages         ChatMessage[]  @relation("SentMessages")
  // Food persistence
  favoriteFoods        UserFavoriteFood[]
  mealItems            UserMealItem[]
}

model Exercise {
  id                        String                     @id
  name                      String
  category                  String
  formula                   String
  description               String
  repCap                    Int?
  requiredMetrics           String[]
  isActive                  Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  workoutSets               WorkoutSet[]
  dailyPerformanceSnapshots DailyPerformanceSnapshot[]
}

model WorkoutSet {
  id              Int      @default(autoincrement())
  userId          Int
  exerciseId      String
  weightLifted    Float?
  actualReps      Int?
  rirLogged       Int?
  calculated1Rm   Float?
  formulaUsed     String
  isCnsFatigue    Boolean  @default(false)
  durationMinutes Float?
  distanceMeters  Float?
  rpeLogged       Float?
  notes           String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise        Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@id([id, createdAt])
  @@index([userId, exerciseId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model DailyPerformanceSnapshot {
  id                   Int      @id @default(autoincrement())
  userId               Int
  exerciseId           String
  periodDays           Int      @default(14)
  snapshotDate         DateTime
  emaOneRepMax         Float?
  baselineAverage1Rm   Float?
  latestLogged1Rm      Float?
  latestClean1Rm       Float?
  latestRirTrend       Float?
  latestSessionFlagged Boolean  @default(false)
  contextSummary       String
  sampleSize           Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise             Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([userId, exerciseId, periodDays, snapshotDate])
  @@index([userId, exerciseId, snapshotDate(sort: Desc)])
}

model FoodCache {
  id                      Int      @id @default(autoincrement())
  source                  String
  sourceId                String
  name                    String
  normalizedName          String
  description             String?
  brand                   String?
  referenceServingSize    Float?
  referenceServingUnit    String?
  caloriesPer100g         Float?
  proteinGramsPer100g     Float?
  carbsGramsPer100g       Float?
  fatGramsPer100g         Float?
  fiberGramsPer100g       Float?
  sugarGramsPer100g       Float?
  sodiumMilligramsPer100g Float?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([source, sourceId])
  @@index([normalizedName])
}

model RecipeCache {
  id              Int      @id @default(autoincrement())
  source          String
  sourceId        String
  title           String
  normalizedTitle String
  image           String
  calories        Float?
  protein         Float?
  cookTime        Int?
  ingredients     String[]
  instructions    String
  sourceUrl       String?
  dietTags        String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([source, sourceId])
  @@index([normalizedTitle])
}

// --- Trainer Marketplace & Blockchain Ready Models ---

model TrainerProfile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio               String?
  certifications    String[]
  rating            Float     @default(0)
  payoutAtaAddress  String?   @unique
  payoutMintAddress String?
  ataInitializedAt  DateTime?

  // Relations
  services         TrainerService[]
  providedBookings Booking[]        @relation("TrainerBookings")
  favoritedBy      FavoriteTrainer[]
  availability     TrainerAvailability[]
  reviews          Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrainerService {
  id        Int            @id @default(autoincrement())
  trainerId Int
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  title            String
  description      String
  priceInLamports  Int? // Token amount in smallest on-chain unit (optional, if not set fiat-only)
  tokenMintAddress String? // Mint address (optional)

  // New FIAT price
  priceInIdr Int? // IDR price for fiat payments (optional, if not set crypto-only)

  // Relations
  bookings Booking[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FavoriteTrainer {
  id               Int            @id @default(autoincrement())
  userId           Int
  trainerProfileId Int
  createdAt        DateTime       @default(now())

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainer          TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, trainerProfileId])
  @@index([userId])
}

model Booking {
  id        Int            @id @default(autoincrement())
  clientId  Int
  client    User           @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  trainerId Int
  trainer   TrainerProfile @relation("TrainerBookings", fields: [trainerId], references: [id], onDelete: Cascade)
  serviceId Int
  service   TrainerService @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  status        BookingStatus @default(PENDING)
  txHash        String?       @unique // Prevents duplicate bookings from indexer replay (crypto)
  escrowAddress String?       @unique

  // --- New Fiat Payment Fields ---
  paymentType         PaymentType? // CRYPTO or FIAT
  fiatAmount          Int?        // Total paid in IDR (including fee)
  servicePriceIdr     Int?        // Base price (excl fee)
  processingFeeIdr    Int?        // Fee amount
  gatewayTxId         String?     @unique // Duitku reference / transaction ID
  gatewayPaymentMethod String?    // e.g., "BCA_VA", "QRIS", "GOPAY"
  webhookReceivedAt   DateTime?   // When we last processed a webhook for this booking

  // Dispute resolution
  disputeReason String? // Filled in when status = DISPUTED
  resolvedBy    Int?    // Admin userId who resolved the dispute

  // BullMQ auto-release job tracking
  releaseJobId  String? // BullMQ job ID for the pending escrow auto-release job (cancelled on early resolution)

  // Scheduling
  scheduledStart DateTime? // Session start time (UTC)
  scheduledEnd   DateTime? // Session end time (UTC)
  timezone       String?   @default("Asia/Jakarta") // Agreed timezone label
  meetingLink    String?   // Optional virtual session URL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations for fiat payments
  paymentTransactions  PaymentTransaction[]

  // Relations for reschedule and cancellation requests
  rescheduleRequests   BookingRescheduleRequest[]   @relation("RescheduleRequests")
  cancellationRequests BookingCancellationRequest[] @relation("CancellationRequests")

  // Review for this completed session (one per booking)
  review               Review?
  conversation Conversation?
}

// --- Trainer Availability / Scheduling ---

model TrainerAvailability {
  id        Int            @id @default(autoincrement())
  trainerId Int
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  // Recurring weekly rule OR date-specific override (one must be set)
  dayOfWeek    Int?      // 0=Sun…6=Sat — recurring weekly slot
  specificDate DateTime? // Date-specific override (takes precedence over dayOfWeek)

  startTime   String  // "09:00" HH:mm in trainer's timezone
  endTime     String  // "17:00" HH:mm in trainer's timezone
  isAvailable Boolean @default(true) // false = blocked (vacation etc.)
  title       String? // e.g. "Working Hours", "On Vacation", "Conference"
  timezone    String  @default("Asia/Jakarta")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trainerId])
  @@index([trainerId, specificDate])
  @@index([trainerId, dayOfWeek])
}

// --- Fiat Payment Models ---

model FiatWallet {
  id          Int      @id @default(autoincrement())
  trainerId   Int      @unique
  balanceIdr  Int      @default(0)
  updatedAt   DateTime @updatedAt
  trainer     User     @relation(fields: [trainerId], references: [id], onDelete: Cascade)
}

model WithdrawalRequest {
  id              Int            @id @default(autoincrement())
  trainerId       Int
  amountIdr       Int
  bankCode        String?
  accountNumber   String?
  accountName     String?
  paymentMethod   String   // "BANK_TRANSFER" or "EWALLET"
  status          WithdrawalStatus @default(PENDING)
  gatewayReference String? @unique
  requestedAt     DateTime @default(now())
  processedAt     DateTime?
  failureReason   String?
  trainer         User     @relation(fields: [trainerId], references: [id], onDelete: Cascade)
}

model PaymentTransaction {
  id               String   @id @default(cuid())
  bookingId        Int
  gateway          String   // "DUITKU"
  gatewayTxId      String   @unique
  amountIdr        Int
  feeIdr           Int
  status           String   // "PENDING", "SUCCESS", "FAILURE", "REFUNDED"
  rawPayload       Json?    // Store webhook body for debugging
  createdAt        DateTime @default(now())
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// --- Notification System ---

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

// --- Reschedule & Cancellation Requests ---

model BookingRescheduleRequest {
  id            Int           @id @default(autoincrement())
  bookingId     Int
  booking       Booking       @relation("RescheduleRequests", fields: [bookingId], references: [id], onDelete: Cascade)
  proposedById  Int           // userId of proposer
  originalStart DateTime?
  originalEnd   DateTime?
  proposedStart DateTime
  proposedEnd   DateTime
  timezone      String        @default("Asia/Jakarta")
  status        RequestStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([bookingId])
  @@index([proposedById])
}

model BookingCancellationRequest {
  id           Int           @id @default(autoincrement())
  bookingId    Int
  booking      Booking       @relation("CancellationRequests", fields: [bookingId], references: [id], onDelete: Cascade)
  proposedById Int           // userId of proposer
  reason       String?
  status       RequestStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([bookingId])
  @@index([proposedById])
}

// --- Review / Rating System ---

model Review {
  id               Int            @id @default(autoincrement())
  bookingId        Int            @unique // one review per booking
  booking          Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  clientId         Int
  client           User           @relation("ClientReviews", fields: [clientId], references: [id], onDelete: Cascade)

  trainerProfileId Int
  trainerProfile   TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)

  rating           Int            // 1 to 5 stars
  comment          String?        // Optional text description
  isAnonymous      Boolean        @default(false)

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([trainerProfileId])
  @@index([clientId])
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
  AUDIO
}

model Conversation {
  id Int @id @default(autoincrement())

  // Optional booking link
  // One booking → one chat
  bookingId Int? @unique
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // Store USER ids directly
  trainerUserId Int
  clientUserId  Int

  trainerUser User @relation("TrainerConversations", fields: [trainerUserId], references: [id], onDelete: Cascade)
  clientUser User @relation("ClientConversations", fields: [clientUserId], references: [id], onDelete: Cascade)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Last message preview
  lastMessageId Int?
  lastMessageAt DateTime?

  // Soft archive
  archivedByTrainer Boolean @default(false)
  archivedByClient Boolean @default(false)

  // Relations
  messages ChatMessage[]

  @@unique([trainerUserId, clientUserId])

  @@index([trainerUserId])
  @@index([clientUserId])
  @@index([lastMessageAt(sort: Desc)])
}



model ChatMessage {
  id Int @id @default(autoincrement())
  conversationId Int
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Sender
  senderId Int
  sender User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  // Message type
  type MessageType @default(TEXT)

  // Text
  content String?

  // Media
  imageUrl String?
  fileUrl String?

  // Voice note
  audioUrl String?
  audioDurationSeconds Int?

  // Delivery state
  isRead Boolean @default(false)
  deliveredAt DateTime?
  readAt DateTime?

  // Edit / delete
  editedAt DateTime?
  deletedAt DateTime?

  // System metadata
  metadata Json?
  createdAt DateTime @default(now())

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@index([conversationId, isRead])
  @@index([createdAt(sort: Desc)])
}

// --- Food Persistence Models ---

enum FoodSource {
  USDA
  OFF // Open Food Facts
}

model UserFavoriteFood {
  id        Int        @id @default(autoincrement())
  userId    Int
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  foodId    String     // External source ID (fdcId or OFF barcode)
  foodName  String
  brand     String?
  source    FoodSource

  createdAt DateTime   @default(now())

  @@unique([userId, foodId, source])
  @@index([userId])
}

model UserMealItem {
  id        Int        @id @default(autoincrement())
  userId    Int
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  foodId       String     // External source ID
  foodName     String
  brand        String?
  source       FoodSource
  servingSize  Float      // grams
  nutrientsJson Json      // Per-100g nutrient data stored as JSON

  addedAt   DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model OutboxEvent {
  id        Int      @id @default(autoincrement())
  eventType String   // "enqueue-auto-release" | "cancel-auto-release"
  payload   Json
  processed Boolean  @default(false)
  retryCount Int      @default(0)
  error      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([processed, createdAt])
}
