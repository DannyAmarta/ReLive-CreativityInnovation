datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User{
  id Int @id @default(autoincrement())
  email String @unique
  password String
  name String?
  bio String?
  avatar String?
  createdAt DateTime @default(now())
  updatedAt DateTime?
}

model FoodCache{
  id Int @id @default(autoincrement())
  source String
  sourceId String
  name String
  normalizedName String
  description String?
  brand String?
  referenceServingSize Float?
  referenceServingUnit String?
  caloriesPer100g Float?
  proteinGramsPer100g Float?
  carbsGramsPer100g Float?
  fatGramsPer100g Float?
  fiberGramsPer100g Float?
  sugarGramsPer100g Float?
  sodiumMilligramsPer100g Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, sourceId])
  @@index([normalizedName])
}

model RecipeCache{
  id Int @id @default(autoincrement())
  source String
  sourceId String
  title String
  normalizedTitle String
  image String
  calories Float?
  protein Float?
  cookTime Int?
  ingredients String[]
  instructions String
  sourceUrl String?
  dietTags String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, sourceId])
  @@index([normalizedTitle])
}
